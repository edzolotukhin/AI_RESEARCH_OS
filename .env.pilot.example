# Copy to .env.pilot on the server. .env.pilot is ignored by Git.
# Values containing CHANGE_ME are intentionally unusable placeholders.
APP_ENV=pilot
PILOT_HOST=research.example.org
ALLOWED_HOSTS=research.example.org
TLS_CONTACT_EMAIL=operator@example.org

POSTGRES_DB=ai_research_os
POSTGRES_USER=ai_research_os
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_DATABASE_PASSWORD

# Used only by the explicit bootstrap-owner command, never by API/worker.
PILOT_OWNER_EMAIL=owner@example.org
PILOT_OWNER_DISPLAY_NAME=Pilot Owner
PILOT_OWNER_PASSWORD=CHANGE_ME_STRONG_RANDOM_OWNER_PASSWORD
PILOT_ADMIN_USER_ID=CHANGE_ME_AFTER_BOOTSTRAP
UI_CSRF_SECRET=CHANGE_ME_STRONG_RANDOM_CSRF_SECRET_AT_LEAST_32_CHARS

# Optional providers. Leave empty when the capability is not enabled.
OPENAI_API_KEY=
SEARCH_API_KEY=
ASSEMBLYAI_API_KEY=
ALLOW_PARTICIPANT_DATA_EXTERNAL_TRANSCRIPTION=0

# Backup destination and key path. Keep the key off the pilot host for disaster recovery.
APP_SHA=CHANGE_ME_EXACT_ACCEPTED_COMMIT_SHA
ALEMBIC_HEAD=023_ux01a_identity_membership
RESTIC_REPOSITORY=CHANGE_ME_REMOTE_RESTIC_REPOSITORY
RESTIC_PASSWORD_FILE_HOST=CHANGE_ME_ABSOLUTE_RUNTIME_SECRET_PATH

# Production method rollout flags retained from the accepted runtime.
ARK_DESK_ENABLED=1
CMF_DESK_ENABLED=1
CMF_QUANT_ENABLED=1
