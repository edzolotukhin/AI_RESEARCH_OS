# Copy to .env and adjust for local development.
# Never commit real credentials.

# DR-02 planner output bounds (ResearchDesign JSON cardinality)
# PLANNER_MAX_RESEARCH_QUESTIONS=6
# PLANNER_MAX_INFORMATION_NEEDS=12
# PLANNER_MAX_SOURCE_STRATEGIES=5
# PLANNER_MAX_ANALYSIS_PLAN_ITEMS=6
# PLANNER_MAX_DELIVERABLE_PLAN_ITEMS=6
# PLANNER_MAX_ASSUMPTIONS=4
# PLANNER_MAX_LIMITATIONS=4

# Planner structured-output generation (OpenAI Responses API)
# max_output_tokens includes BOTH visible JSON and internal reasoning tokens.
# PLANNER_REASONING_EFFORT=minimal
# PLANNER_MAX_OUTPUT_TOKENS=8192
# PLANNER_SEMANTIC_MAX_ATTEMPTS=3

# Application LLM settings (optional overrides)
# OPENAI_API_KEY=

# Test/smoke only — returns fixed planner JSON without calling a live model.
# DETERMINISTIC_PLANNER=1

# Persistence backend: file | memory | postgresql
PERSISTENCE_BACKEND=file

# Background execution topology: disabled | embedded | external
# - external: PostgreSQL + separate worker (default when PERSISTENCE_BACKEND=postgresql)
# - embedded: in-process worker drain (tests; required for memory HTTP 202)
# - disabled: no HTTP background submission (default for memory/file)
# BACKGROUND_EXECUTION_MODE=disabled

# PostgreSQL connection (required when PERSISTENCE_BACKEND=postgresql)
DATABASE_URL=postgresql+psycopg://ai_research_os:ai_research_os_dev@localhost:5432/ai_research_os

# Integration tests only — database name must contain "test"
DATABASE_URL_TEST=postgresql+psycopg://ai_research_os:ai_research_os_dev@localhost:5432/ai_research_os_test

# Explicit opt-in for destructive integration test setup
POSTGRESQL_INTEGRATION_TESTS=0

# DR-03 search provider: tavily | deterministic
# Production default is tavily and requires SEARCH_API_KEY when search runs.
# SEARCH_PROVIDER=tavily
# SEARCH_API_KEY=

# Test/smoke only — deterministic search/retrieval without external API calls.
# SEARCH_PROVIDER=deterministic

# DR-04 evidence extractor: llm | deterministic
# Production default is llm and uses the application LLM client.
# EVIDENCE_EXTRACTOR=llm

# Test/smoke only — deterministic grounded evidence extraction.
# EVIDENCE_EXTRACTOR=deterministic

# Bounded extraction input (normalized characters per chunk / overlap)
# EVIDENCE_EXTRACTION_CHUNK_CHARS=8000
# EVIDENCE_EXTRACTION_CHUNK_OVERLAP_CHARS=500

# DR-05 analysis engine: llm | deterministic
# Production default is llm and uses the application LLM client.
# ANALYSIS_ENGINE=llm

# Test/smoke only — deterministic findings/insights from persisted evidence.
# ANALYSIS_ENGINE=deterministic

# Bounded analysis input (evidence items / chars per batch)
# ANALYSIS_MAX_EVIDENCE_PER_BATCH=20
# ANALYSIS_MAX_CHARS_PER_BATCH=12000

# DR-06 report writer: llm | deterministic
# REPORT_ENGINE=llm
# REPORT_ENGINE=deterministic
# REPORT_MAX_FINDINGS_PER_BATCH=20
# REPORT_MAX_CHARS_PER_BATCH=12000

# DR-07 review gate: llm | deterministic
# REVIEW_ENGINE=llm
# REVIEW_ENGINE=deterministic
# REVIEW_MAX_REVISION_ATTEMPTS=1
# REVIEW_MAX_CHARS_PER_SECTION=8000
# REVIEW_MAX_ISSUES_PER_SECTION=5

# External orchestrator HTTP access (n8n, scripts). Never commit real keys.
# Bootstrap with: python -m tools.create_api_key --name n8n
# AI_RESEARCH_OS_API_URL=http://localhost:8000
# AI_RESEARCH_OS_API_KEY=
