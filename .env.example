# Copy to .env and adjust for local development.
# Never commit real credentials.

# Application LLM settings (optional overrides)
# OPENAI_API_KEY=

# Persistence backend: file | memory | postgresql
PERSISTENCE_BACKEND=file

# PostgreSQL connection (required when PERSISTENCE_BACKEND=postgresql)
DATABASE_URL=postgresql+psycopg://ai_research_os:ai_research_os_dev@localhost:5432/ai_research_os

# Integration tests only — database name must contain "test"
DATABASE_URL_TEST=postgresql+psycopg://ai_research_os:ai_research_os_dev@localhost:5432/ai_research_os_test

# Explicit opt-in for destructive integration test setup
POSTGRESQL_INTEGRATION_TESTS=0
