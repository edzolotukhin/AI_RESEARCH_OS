{
  "name": "AI Research OS — Fetch Results and Artifacts",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.AI_RESEARCH_OS_API_URL || 'http://api:8000'}}/workflow-runs/{{$json.run_id}}/results",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.AI_RESEARCH_OS_API_KEY}}"
            }
          ]
        }
      },
      "id": "fetch-results",
      "name": "Fetch Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 240]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.AI_RESEARCH_OS_API_URL || 'http://api:8000'}}/workflow-runs/{{$json.run_id}}/artifacts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.AI_RESEARCH_OS_API_KEY}}"
            }
          ]
        }
      },
      "id": "fetch-artifacts",
      "name": "Fetch Artifacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 360]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          { "node": "Fetch Results", "type": "main", "index": 0 },
          { "node": "Fetch Artifacts", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "pf07-fetch-results-v1"
}
