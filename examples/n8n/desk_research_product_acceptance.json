{
  "name": "Desk Research — Product Acceptance",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "correlation_id",
              "value": "={{$execution.id}}"
            },
            {
              "name": "idempotency_key",
              "value": "={{'n8n-' + $execution.id}}"
            },
            {
              "name": "api_url",
              "value": "={{$env.AI_RESEARCH_OS_API_URL || 'http://api:8000'}}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-vars",
      "name": "Set Orchestration Vars",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.api_url}}/projects",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.AI_RESEARCH_OS_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"name\": \"n8n Desk Research Acceptance\"}",
        "options": {
          "retry": {
            "enabled": true,
            "maxTries": 3
          }
        }
      },
      "id": "create-project",
      "name": "Create Project",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$('Set Orchestration Vars').item.json.api_url}}/projects/{{$json.id}}/research",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.AI_RESEARCH_OS_API_KEY}}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{$('Set Orchestration Vars').item.json.idempotency_key}}"
            },
            {
              "name": "X-Correlation-ID",
              "value": "={{$('Set Orchestration Vars').item.json.correlation_id}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ brief: { title: 'Brand Health 2026', business_question: 'Assess market position.', objectives: ['Evaluate brand awareness.'], geography: ['Germany'], market: 'Pet food', target_entities: ['Purina'], timeframe: '2026', constraints: [], deliverables: ['Executive summary'], language: 'en', context: 'Client: Purina', known_information: [], exclusions: [] }, source: 'n8n', correlation_id: $('Set Orchestration Vars').item.json.correlation_id }) }}",
        "options": {
          "retry": {
            "enabled": true,
            "maxTries": 3
          }
        }
      },
      "id": "submit-research",
      "name": "Submit Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "jsCode": "const vars = $('Set Orchestration Vars').first().json;\nconst submit = $('Submit Research').first().json;\nconst project = $('Create Project').first().json;\nconst maxAttempts = parseInt($env.N8N_MAX_POLL_ATTEMPTS || '120', 10);\nreturn [{\n  json: {\n    run_id: submit.run_id,\n    poll_attempt: 0,\n    max_poll_attempts: maxAttempts,\n    api_url: vars.api_url,\n    correlation_id: vars.correlation_id,\n    idempotency_key: vars.idempotency_key,\n    project_id: project.id,\n  },\n}];"
      },
      "id": "prepare-poll-loop",
      "name": "Prepare Poll Loop",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.api_url + '/workflow-runs/' + $json.run_id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.AI_RESEARCH_OS_API_KEY}}"
            }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "maxTries": 3
          }
        }
      },
      "id": "poll-run",
      "name": "Poll Workflow Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "jsCode": "const loopState = $('Continue Poll Loop').isExecuted\n  ? $('Continue Poll Loop').first().json\n  : $('Prepare Poll Loop').first().json;\nconst poll = $input.first().json;\nconst attempt = loopState.poll_attempt + 1;\nreturn [{\n  json: {\n    ...poll,\n    run_id: loopState.run_id,\n    api_url: loopState.api_url,\n    project_id: loopState.project_id,\n    correlation_id: loopState.correlation_id,\n    idempotency_key: loopState.idempotency_key,\n    poll_attempt: attempt,\n    max_poll_attempts: loopState.max_poll_attempts,\n  },\n}];"
      },
      "id": "process-poll-response",
      "name": "Process Poll Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1520, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.is_terminal}}",
              "value2": true
            }
          ]
        }
      },
      "id": "terminal-check",
      "name": "Is Terminal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1740, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.poll_attempt}}",
              "operation": "largerEqual",
              "value2": "={{$json.max_poll_attempts}}"
            }
          ]
        }
      },
      "id": "max-attempts-check",
      "name": "Max Poll Attempts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1740, 520]
    },
    {
      "parameters": {
        "amount": "={{ $env.N8N_POLL_INTERVAL_SECONDS || 3 }}",
        "unit": "seconds"
      },
      "id": "wait",
      "name": "Wait Poll Interval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1960, 620]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    run_id: item.run_id,\n    poll_attempt: item.poll_attempt,\n    max_poll_attempts: item.max_poll_attempts,\n    api_url: item.api_url,\n    project_id: item.project_id,\n    correlation_id: item.correlation_id,\n    idempotency_key: item.idempotency_key,\n  },\n}];"
      },
      "id": "continue-poll-loop",
      "name": "Continue Poll Loop",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2180, 620]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "equal",
              "value2": "completed"
            },
            {
              "value1": "={{$json.final_review_verdict}}",
              "operation": "equal",
              "value2": "approve"
            }
          ],
          "boolean": [
            {
              "value1": "={{$json.final_artifact_available}}",
              "value2": true
            }
          ]
        },
        "combineOperation": "all"
      },
      "id": "success-check",
      "name": "Approved Final Artifact?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1960, 180]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.final_review_verdict}}",
              "operation": "equal",
              "value2": "reject"
            }
          ]
        }
      },
      "id": "reject-check",
      "name": "Review Rejected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2180, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "equal",
              "value2": "failed"
            }
          ]
        }
      },
      "id": "failed-check",
      "name": "Workflow Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2180, 420]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.api_url + '/artifacts/' + $json.final_artifact_id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.AI_RESEARCH_OS_API_KEY}}"
            }
          ]
        }
      },
      "id": "fetch-artifact-meta",
      "name": "Fetch Artifact Metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2180, 80]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$('Process Poll Response').item.json.api_url + '/artifacts/' + $('Process Poll Response').item.json.final_artifact_id + '/content'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.AI_RESEARCH_OS_API_KEY}}"
            }
          ]
        }
      },
      "id": "fetch-artifact-content",
      "name": "Fetch Artifact Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2400, 80]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "project_id",
              "value": "={{$('Process Poll Response').item.json.project_id}}"
            },
            {
              "name": "run_id",
              "value": "={{$('Process Poll Response').item.json.run_id || $('Process Poll Response').item.json.id}}"
            },
            {
              "name": "status",
              "value": "={{$('Process Poll Response').item.json.status}}"
            },
            {
              "name": "review_verdict",
              "value": "={{$('Process Poll Response').item.json.final_review_verdict}}"
            },
            {
              "name": "artifact_id",
              "value": "={{$('Process Poll Response').item.json.final_artifact_id}}"
            },
            {
              "name": "artifact_filename",
              "value": "={{$json.filename}}"
            },
            {
              "name": "artifact_media_type",
              "value": "={{$json.media_type}}"
            },
            {
              "name": "artifact_checksum",
              "value": "={{$('Fetch Artifact Content').item.json.content_checksum}}"
            },
            {
              "name": "artifact_content",
              "value": "={{$('Fetch Artifact Content').item.json.content}}"
            },
            {
              "name": "correlation_id",
              "value": "={{$('Process Poll Response').item.json.correlation_id}}"
            },
            {
              "name": "idempotency_key",
              "value": "={{$('Process Poll Response').item.json.idempotency_key}}"
            },
            {
              "name": "poll_attempt",
              "value": "={{String($('Process Poll Response').item.json.poll_attempt)}}"
            },
            {
              "name": "outcome",
              "value": "success"
            }
          ]
        },
        "options": {}
      },
      "id": "success-output",
      "name": "Success Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [2620, 80]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "run_id",
              "value": "={{$json.run_id || $json.id}}"
            },
            {
              "name": "status",
              "value": "={{$json.status}}"
            },
            {
              "name": "review_verdict",
              "value": "={{$json.final_review_verdict || 'reject'}}"
            },
            {
              "name": "poll_attempt",
              "value": "={{String($json.poll_attempt)}}"
            },
            {
              "name": "outcome",
              "value": "rejected"
            }
          ]
        },
        "options": {}
      },
      "id": "rejected-output",
      "name": "Rejected Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [2400, 260]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "run_id",
              "value": "={{$json.run_id || $json.id}}"
            },
            {
              "name": "status",
              "value": "={{$json.status}}"
            },
            {
              "name": "review_verdict",
              "value": "={{$json.final_review_verdict || 'none'}}"
            },
            {
              "name": "poll_attempt",
              "value": "={{String($json.poll_attempt)}}"
            },
            {
              "name": "outcome",
              "value": "failed"
            }
          ]
        },
        "options": {}
      },
      "id": "failed-output",
      "name": "Failed Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [2400, 380]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "run_id",
              "value": "={{$json.run_id || $json.id}}"
            },
            {
              "name": "status",
              "value": "={{$json.status}}"
            },
            {
              "name": "review_verdict",
              "value": "={{$json.final_review_verdict || 'none'}}"
            },
            {
              "name": "poll_attempt",
              "value": "={{String($json.poll_attempt)}}"
            },
            {
              "name": "outcome",
              "value": "contract_failure"
            }
          ]
        },
        "options": {}
      },
      "id": "contract-failure-output",
      "name": "Contract Failure Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [2400, 500]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "run_id",
              "value": "={{$json.run_id || $json.id}}"
            },
            {
              "name": "status",
              "value": "={{$json.status || 'pending'}}"
            },
            {
              "name": "review_verdict",
              "value": "={{$json.final_review_verdict || 'none'}}"
            },
            {
              "name": "poll_attempt",
              "value": "={{String($json.poll_attempt)}}"
            },
            {
              "name": "max_poll_attempts",
              "value": "={{String($json.max_poll_attempts)}}"
            },
            {
              "name": "outcome",
              "value": "poll_timeout"
            }
          ]
        },
        "options": {}
      },
      "id": "timeout-output",
      "name": "Poll Timeout Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1960, 460]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Set Orchestration Vars", "type": "main", "index": 0 }]]
    },
    "Set Orchestration Vars": {
      "main": [[{ "node": "Create Project", "type": "main", "index": 0 }]]
    },
    "Create Project": {
      "main": [[{ "node": "Submit Research", "type": "main", "index": 0 }]]
    },
    "Submit Research": {
      "main": [[{ "node": "Prepare Poll Loop", "type": "main", "index": 0 }]]
    },
    "Prepare Poll Loop": {
      "main": [[{ "node": "Poll Workflow Run", "type": "main", "index": 0 }]]
    },
    "Poll Workflow Run": {
      "main": [[{ "node": "Process Poll Response", "type": "main", "index": 0 }]]
    },
    "Process Poll Response": {
      "main": [[{ "node": "Is Terminal?", "type": "main", "index": 0 }]]
    },
    "Is Terminal?": {
      "main": [
        [{ "node": "Approved Final Artifact?", "type": "main", "index": 0 }],
        [{ "node": "Max Poll Attempts?", "type": "main", "index": 0 }]
      ]
    },
    "Max Poll Attempts?": {
      "main": [
        [{ "node": "Poll Timeout Payload", "type": "main", "index": 0 }],
        [{ "node": "Wait Poll Interval", "type": "main", "index": 0 }]
      ]
    },
    "Wait Poll Interval": {
      "main": [[{ "node": "Continue Poll Loop", "type": "main", "index": 0 }]]
    },
    "Continue Poll Loop": {
      "main": [[{ "node": "Poll Workflow Run", "type": "main", "index": 0 }]]
    },
    "Approved Final Artifact?": {
      "main": [
        [{ "node": "Fetch Artifact Metadata", "type": "main", "index": 0 }],
        [{ "node": "Review Rejected?", "type": "main", "index": 0 }]
      ]
    },
    "Review Rejected?": {
      "main": [
        [{ "node": "Rejected Payload", "type": "main", "index": 0 }],
        [{ "node": "Workflow Failed?", "type": "main", "index": 0 }]
      ]
    },
    "Workflow Failed?": {
      "main": [
        [{ "node": "Failed Payload", "type": "main", "index": 0 }],
        [{ "node": "Contract Failure Payload", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Artifact Metadata": {
      "main": [[{ "node": "Fetch Artifact Content", "type": "main", "index": 0 }]]
    },
    "Fetch Artifact Content": {
      "main": [[{ "node": "Success Payload", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 3600
  },
  "versionId": "n8n-desk-research-product-acceptance-v2"
}
