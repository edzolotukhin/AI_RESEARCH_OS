{
  "name": "Desk Research — Product Acceptance",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "orch-correlation-id",
              "name": "correlation_id",
              "value": "={{$execution.id}}",
              "type": "string"
            },
            {
              "id": "orch-idempotency-key",
              "name": "idempotency_key",
              "value": "={{'n8n-' + $execution.id}}",
              "type": "string"
            },
            {
              "id": "orch-api-url",
              "name": "api_url",
              "value": "={{$env.AI_RESEARCH_OS_API_URL || 'http://api:8000'}}",
              "type": "string"
            },
            {
              "id": "orch-poll-interval",
              "name": "poll_interval_seconds",
              "value": "={{$env.N8N_POLL_INTERVAL_SECONDS || '3'}}",
              "type": "string"
            },
            {
              "id": "orch-max-attempts",
              "name": "max_poll_attempts",
              "value": "={{$env.N8N_MAX_POLL_ATTEMPTS || '120'}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-vars",
      "name": "Set Orchestration Vars",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $env.N8N_RESEARCH_BRIEF_JSON;\nif (!raw || !String(raw).trim()) {\n  throw new Error(\n    'N8N_RESEARCH_BRIEF_JSON is required. Set container env to a canonical ResearchBrief JSON object before executing this workflow.'\n  );\n}\nlet brief;\ntry {\n  brief = JSON.parse(String(raw));\n} catch (error) {\n  throw new Error('N8N_RESEARCH_BRIEF_JSON must be valid JSON for a ResearchBrief object.');\n}\nif (!brief || typeof brief !== 'object' || Array.isArray(brief)) {\n  throw new Error('N8N_RESEARCH_BRIEF_JSON must decode to a ResearchBrief object.');\n}\nfor (const field of ['title', 'business_question', 'language']) {\n  if (!String(brief[field] || '').trim()) {\n    throw new Error(`ResearchBrief.${field} is required.`);\n  }\n}\nif (!Array.isArray(brief.objectives) || brief.objectives.length === 0) {\n  throw new Error('ResearchBrief.objectives must contain at least one objective.');\n}\nreturn [{ json: { brief } }];"
      },
      "id": "parse-research-brief",
      "name": "Parse Research Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$('Set Orchestration Vars').item.json.api_url}}/projects",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.AI_RESEARCH_OS_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"name\": \"n8n Desk Research Acceptance\"}",
        "options": {
          "retry": {
            "enabled": true,
            "maxTries": 3
          }
        }
      },
      "id": "create-project",
      "name": "Create Project",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$('Set Orchestration Vars').item.json.api_url}}/projects/{{$json.id}}/research",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.AI_RESEARCH_OS_API_KEY}}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{$('Set Orchestration Vars').item.json.idempotency_key}}"
            },
            {
              "name": "X-Correlation-ID",
              "value": "={{$('Set Orchestration Vars').item.json.correlation_id}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ brief: $('Parse Research Brief').item.json.brief, source: 'n8n', correlation_id: $('Set Orchestration Vars').item.json.correlation_id }) }}",
        "options": {
          "retry": {
            "enabled": true,
            "maxTries": 3
          }
        }
      },
      "id": "submit-research",
      "name": "Submit Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "jsCode": "const vars = $('Set Orchestration Vars').first().json;\nconst submit = $('Submit Research').first().json;\nconst project = $('Create Project').first().json;\nconst maxAttempts = parseInt(String(vars.max_poll_attempts || $env.N8N_MAX_POLL_ATTEMPTS || '120'), 10);\nreturn [{\n  json: {\n    run_id: submit.run_id,\n    poll_attempt: 0,\n    max_poll_attempts: maxAttempts,\n    api_url: vars.api_url,\n    correlation_id: vars.correlation_id,\n    idempotency_key: vars.idempotency_key,\n    project_id: project.id,\n    poll_interval_seconds: vars.poll_interval_seconds,\n  },\n}];"
      },
      "id": "prepare-poll-loop",
      "name": "Prepare Poll Loop",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.api_url + '/workflow-runs/' + $json.run_id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.AI_RESEARCH_OS_API_KEY}}"
            }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "maxTries": 3
          }
        }
      },
      "id": "poll-run",
      "name": "Poll Workflow Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 300]
    },
    {
      "parameters": {
        "jsCode": "const loopState = $('Continue Poll Loop').isExecuted\n  ? $('Continue Poll Loop').first().json\n  : $('Prepare Poll Loop').first().json;\nconst poll = $input.first().json;\nconst attempt = loopState.poll_attempt + 1;\nreturn [{\n  json: {\n    ...poll,\n    run_id: loopState.run_id,\n    api_url: loopState.api_url,\n    project_id: loopState.project_id,\n    correlation_id: loopState.correlation_id,\n    idempotency_key: loopState.idempotency_key,\n    poll_attempt: attempt,\n    max_poll_attempts: loopState.max_poll_attempts,\n    poll_interval_seconds: loopState.poll_interval_seconds,\n    status: poll.status,\n    is_terminal: poll.is_terminal,\n    final_review_verdict: poll.final_review_verdict ?? null,\n    final_artifact_available: poll.final_artifact_available ?? false,\n    final_artifact_id: poll.final_artifact_id ?? null,\n  },\n}];"
      },
      "id": "process-poll-response",
      "name": "Process Poll Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1740, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.is_terminal}}",
              "value2": true
            }
          ]
        }
      },
      "id": "terminal-check",
      "name": "Is Terminal?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1960, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.poll_attempt}}",
              "operation": "largerEqual",
              "value2": "={{$json.max_poll_attempts}}"
            }
          ]
        }
      },
      "id": "max-attempts-check",
      "name": "Max Poll Attempts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1960, 520]
    },
    {
      "parameters": {
        "amount": "={{ $('Set Orchestration Vars').item.json.poll_interval_seconds || $env.N8N_POLL_INTERVAL_SECONDS || 3 }}",
        "unit": "seconds"
      },
      "id": "wait",
      "name": "Wait Poll Interval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2180, 620]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nreturn [{\n  json: {\n    run_id: item.run_id,\n    poll_attempt: item.poll_attempt,\n    max_poll_attempts: item.max_poll_attempts,\n    api_url: item.api_url,\n    project_id: item.project_id,\n    correlation_id: item.correlation_id,\n    idempotency_key: item.idempotency_key,\n    poll_interval_seconds: item.poll_interval_seconds,\n  },\n}];"
      },
      "id": "continue-poll-loop",
      "name": "Continue Poll Loop",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2400, 620]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "equal",
              "value2": "completed"
            },
            {
              "value1": "={{$json.final_review_verdict}}",
              "operation": "equal",
              "value2": "approve"
            },
            {
              "value1": "={{$json.final_artifact_id}}",
              "operation": "isNotEmpty"
            }
          ],
          "boolean": [
            {
              "value1": "={{$json.final_artifact_available}}",
              "value2": true
            }
          ]
        },
        "combineOperation": "all"
      },
      "id": "success-check",
      "name": "Approved Final Artifact?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2180, 180]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.final_review_verdict}}",
              "operation": "equal",
              "value2": "reject"
            }
          ]
        }
      },
      "id": "reject-check",
      "name": "Review Rejected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "equal",
              "value2": "failed"
            }
          ]
        }
      },
      "id": "failed-check",
      "name": "Workflow Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2400, 420]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$('Process Poll Response').item.json.api_url + '/artifacts/' + $('Process Poll Response').item.json.final_artifact_id}}",
        "sendHeaders": true,
