              "type": "string"
            },
            {
              "id": "success-correlation-id",
              "name": "correlation_id",
              "value": "={{$('Process Poll Response').item.json.correlation_id}}",
              "type": "string"
            },
            {
              "id": "success-idempotency-key",
              "name": "idempotency_key",
              "value": "={{$('Process Poll Response').item.json.idempotency_key}}",
              "type": "string"
            },
            {
              "id": "success-poll-attempt",
              "name": "poll_attempt",
              "value": "={{String($('Process Poll Response').item.json.poll_attempt)}}",
              "type": "string"
            },
            {
              "id": "success-outcome",
              "name": "outcome",
              "value": "success",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "success-output",
      "name": "Success Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2840, 80]
    },
