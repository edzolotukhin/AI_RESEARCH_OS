# Disposable restore drill only. Never point this file at production resources.
POSTGRES_DB=ai_research_os_restore_drill
POSTGRES_USER=restore_drill
POSTGRES_PASSWORD=CHANGE_ME_DISPOSABLE_ONLY

# Must match the backup manifest and the runtime used for verification.
APP_SHA=CHANGE_ME_EXACT_BACKUP_APPLICATION_SHA
ALEMBIC_HEAD=028_research_authority_extension

# Remote restic repository URI reachable from inside the recovery container.
RESTIC_REPOSITORY=CHANGE_ME_READ_ONLY_RESTIC_REPOSITORY
RESTIC_PASSWORD_FILE_HOST=/absolute/path/to/recovery-restic-password
RESTORE_CONFIRMATION=DISPOSABLE_EMPTY_TARGET
